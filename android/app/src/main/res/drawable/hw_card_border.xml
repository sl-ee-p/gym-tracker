<?xml version="1.0" encoding="utf-8"?>
<!-- Hairline border, drawn as its own layer above hw_card_surface because a
     single drawable can only take one runtime tint and the fill and the
     stroke are different colours. Transparent fill, so only the stroke
     pixels pick up the colour filter.

     Matches AppTheme's cardTheme side: outlineVariant at 60%. Over a busy
     wallpaper it is what keeps the card's edge readable. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="16dp" />
    <solid android:color="@android:color/transparent" />
    <stroke
        android:width="1dp"
        android:color="@color/hw_card_border_default" />
</shape>
